# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit real values.

# DEMO_MODE=true turns on /demo, which shows sample data without an Epic login.
DEMO_MODE=false

# Session secret. Required when DEMO_MODE=false.
# Use a random string of at least 32 characters, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your Epic sandbox app (register it at https://fhir.epic.com under "Build Apps").
# Use the non-production client ID.
CLIENT_ID=your-non-production-client-id

# Must match a redirect URI registered for the app in Epic.
REDIRECT_URI=http://localhost:3000/callback

# Epic sandbox FHIR R4 base URL
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# Scopes requested at login. They must match the APIs enabled for the app in Epic.
SMART_SCOPES=launch/patient openid fhirUser patient/Patient.read patient/Observation.read patient/Condition.read patient/MedicationRequest.read

# Observation categories to search (comma-separated). Epic needs a category for Observation searches.
OBSERVATION_CATEGORIES=laboratory,vital-signs

# Port for the local server
PORT=3000

# DEBUG=true turns on the /api/debug/* endpoints. Use it for local testing only.
DEBUG=false

# Optional settings for running behind HTTPS:
# NODE_ENV=production sends the session cookie over HTTPS only.
# TRUST_PROXY=1 is needed when a reverse proxy in front of the app ends HTTPS.
# NODE_ENV=production
# TRUST_PROXY=1
